  "validation_rules": {
    "required_fields": [
      "received_at",
      "intake_channel",
      "owner_person",
      "customer_org",
      "customer_contact_person",
      "customer_issue_summary"
    ],
    "field_rules": {
      "owner_email": {
        "pattern": "^[^@]+@[^@]+\\.[^@]+$"
      },
      "owner_phone": {
        "pattern": "^(01[0-9]|02|0[3-9][0-9])[- .]?\\d{3,4}[- .]?\\d{4}$"
      },
      "customer_contact_email": {
        "pattern": "^[^@]+@[^@]+\\.[^@]+$"
      },
      "customer_contact_phone": {
        "pattern": "^(01[0-9]|02|0[3-9][0-9])[- .]?\\d{3,4}[- .]?\\d{4}$"
      },
      "customer_business_id": {
        "pattern": "^\\d{3}-\\d{2}-\\d{5}$"
      },
      "monthly_fee": {
        "currency": "KRW",
        "min_value": 0
      },
      "daily_compensation_amount": {
        "currency": "KRW",
        "min_value": 0
      }
    },
    "cross_field_rules": []
  },
  "sensitivity_profile": {
    "profile_id": "customer_inquiry_log_standard_v1",
    "level": "high",
    "contains": [
      "person",
      "org",
      "email",
      "phone",
      "business_reg_no",
      "amount",
      "free_text"
