  "template_text": "계약 검토 의뢰서\n의뢰일: {{request_date}}\n의뢰자: {{requester_org}} {{requester_person}} ({{requester_email}} / {{requester_phone}})\n수신: 외부 법률 자문단\n\n상대방명: {{counterparty_org}}\n대표자: {{counterparty_ceo}}\n본점 주소: {{counterparty_address}}\n연락처: {{counterparty_phone}} / {{counterparty_email}}\n사업자등록번호: {{counterparty_business_id}}\n\n계약명: {{contract_name}}\n계약 유형: {{contract_type}}\n총 계약금액: {{contract_amount}}\n분쟁해결조항: {{dispute_resolution_clause}}\n\n검토 필요 사항:\n{{internal_review_points}}\n\n담당: {{requester_person}} ({{requester_phone}} / {{requester_email}})\n검토의뢰일: {{request_date}}",
  "validation_rules": {
    "required_fields": [
      "request_date",
      "requester_org",
      "requester_person",
      "requester_email",
      "requester_phone",
      "counterparty_org",
      "counterparty_ceo",
      "counterparty_address",
      "counterparty_business_id",
      "contract_name",
      "contract_type",
      "contract_amount"
    ],
    "field_rules": {
      "requester_email": {
        "pattern": "^[^@]+@[^@]+\\.[^@]+$"
      },
      "requester_phone": {
        "pattern": "^(01[0-9]|02|0[3-9][0-9])[- .]?\\d{3,4}[- .]?\\d{4}$"
      },
      "contract_amount": {
        "currency": "KRW",
        "min_value": 0
      }
    },
    "cross_field_rules": []
  },
  "sensitivity_profile": {
    "profile_id": "contract_review_strict_v1",
    "level": "high",
    "contains": ["person", "org", "email", "phone", "amount", "business_reg_no", "address"],
    "default_masking": "strict_token",
    "field_overrides": {
